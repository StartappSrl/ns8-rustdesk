import os
import sys
import json
import agent
import agent.tasks

data = json.load(sys.stdin)

traefik_id = agent.resolve_agent_id('traefik@node')
if traefik_id is None:
    sys.exit(2)

# The route "instance" starts with MODULE_ID: it is removed with the module
response = agent.tasks.run(
    agent_id=traefik_id,
    action='set-route',
    data={
        'instance': os.environ['MODULE_ID'],
        'url': f'http://127.0.0.1:{os.environ["TCP_PORT"]}',
        'host': data["host"],
        'lets_encrypt': data.get("lets_encrypt", True),
        'http2https': data.get("http2https", True),
    },
)

agent.assert_exp(response['exit_code'] == 0)
