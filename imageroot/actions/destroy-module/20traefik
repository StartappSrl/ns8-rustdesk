import os
import sys
import agent
import agent.tasks

traefik_id = agent.resolve_agent_id('traefik@node')
if traefik_id:
    module_id = os.environ['MODULE_ID']
    for instance in (module_id, f"{module_id}-admin", f"{module_id}-adminapi"):
        response = agent.tasks.run(
            agent_id=traefik_id,
            action='delete-route',
            data={'instance': instance},
        )
        # Do not block the module removal if a route is already gone
        if response['exit_code'] != 0:
            print(f"Warning: removal of Traefik route {instance} failed", file=sys.stderr)
