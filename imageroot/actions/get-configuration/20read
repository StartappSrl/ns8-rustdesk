import os
import sys
import json
import subprocess

def read_public_key():
    """Return the hbbs public key, or "" if hbbs never started yet"""
    proc = subprocess.run(
        ["podman", "volume", "inspect", "rustdesk-data", "--format", "{{.Mountpoint}}"],
        capture_output=True, text=True,
    )
    if proc.returncode != 0:
        return ""
    try:
        with open(os.path.join(proc.stdout.strip(), "id_ed25519.pub")) as fp:
            return fp.read().strip()
    except OSError:
        return ""


public_key = read_public_key()

config = {
    "host": os.getenv("TRAEFIK_HOST", ""),
    "rustdesk_host": os.getenv("RUSTDESK_HOST", ""),
    "lets_encrypt": os.getenv("TRAEFIK_LETS_ENCRYPT", "True") == "True",
    "http2https": os.getenv("TRAEFIK_HTTP2HTTPS", "True") == "True",
    "web_client": os.getenv("RUSTDESK_WEB_CLIENT", "0") == "1",
    "ban_threshold": int(os.getenv("RUSTDESK_BAN_THRESHOLD", "5")),
    "log_retention_days": int(os.getenv("RUSTDESK_LOG_RETENTION_DAYS", "180")),
    "admin_allowlist": [e for e in os.getenv("RUSTDESK_ADMIN_ALLOWLIST", "").split(",") if e],
    "public_key": public_key,
}

json.dump(config, fp=sys.stdout)
