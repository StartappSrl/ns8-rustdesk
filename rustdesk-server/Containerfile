# rustdesk-server with secure TCP on hbbs.
#
# RustDesk clients logged in to the API server (the web console account)
# encrypt their connection to hbbs: they wait for a key exchange message
# that the open source hbbs never sends, and every connection fails with
# "Failed to secure tcp: deadline has elapsed". The patch adds the key
# exchange (0001-hbbs-secure-tcp.patch); clients that are not logged in
# ignore it and keep working as before.
#
# Only hbbs is rebuilt, from the same upstream release as the image below;
# hbbr is the upstream binary.
#

# Upstream release matching the image below. When updating the image,
# update both, then check that the patch still applies.
ARG RUSTDESK_SERVER_COMMIT=73523b31cfd25d77dee862e6fc9f5e1fb5e485ef

FROM docker.io/library/rust:1.90.0-alpine3.22 AS build
ARG RUSTDESK_SERVER_COMMIT
RUN apk add --no-cache git build-base binutils
WORKDIR /src
RUN git init -q . \
    && git remote add origin https://github.com/rustdesk/rustdesk-server.git \
    && git fetch -q --depth 1 origin "${RUSTDESK_SERVER_COMMIT}" \
    && git checkout -q FETCH_HEAD \
    && git submodule update -q --init --depth 1
COPY 0001-hbbs-secure-tcp.patch /tmp/
RUN git apply --verbose /tmp/0001-hbbs-secure-tcp.patch
# The upstream image has no libc: the binary must be fully static (musl)
RUN cargo build --release --locked --bin hbbs \
    && if readelf -d target/release/hbbs | grep -q NEEDED; then \
        echo "hbbs is not a static binary" >&2; exit 1; \
    fi \
    && strip target/release/hbbs

FROM docker.io/rustdesk/rustdesk-server:1.1.16
COPY --from=build /src/target/release/hbbs /usr/bin/hbbs
