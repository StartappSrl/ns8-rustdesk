{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "regexManagers": [
    {
      "fileMatch": ["build-images.sh"],
      "matchStrings": [
        "docker\\.io/rustdesk/rustdesk-server:(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "rustdesk/rustdesk-server"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["lejianwen/rustdesk-api"],
      "versioning": "loose",
      "prBodyNotes": [
        "**Prima del merge:** aggiorna `RUSTDESK_API_WEB_COMMIT` in `rustdesk-api/Containerfile` con il commit di rustdesk-api-web usato da questa versione, e controlla se `en.json` / `en.toml` hanno nuove chiavi da tradurre in `it.json` / `it.toml`."
      ]
    },
    {
      "matchPackageNames": ["node"],
      "matchFileNames": ["rustdesk-api/Containerfile"],
      "allowedVersions": "<21"
    }
  ]
}
